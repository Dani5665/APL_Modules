# Copy to .env and fill in. Never commit the real .env.

# --- Deployment image ---
# docker-compose.yml runs ghcr.io/dani5665/apl_modules:${IMAGE_TAG:-latest} -
# the image .github/workflows/docker-publish.yml builds and publishes on
# every push to master, already tested there (go vet, staticcheck,
# govulncheck, go test). Leave unset for `latest` (always the newest build
# on master); pin to an immutable tag (a commit's short SHA, or a release's
# vX.Y.Z tag) for a deployment that only changes when you deliberately bump
# it.
# IMAGE_TAG=latest

# --- HTTP ---
# The address the container listens on. TLS is terminated by the proxy.
APP_ADDR=:8080

# The public URL of the application. Used in the {{request_link}} placeholder.
APP_BASE_URL=https://moduli.example.com

# --- Storage ---
# SQLite and the daily backups live here. Mount it as a volume.
DATA_DIR=/data

# --- External (read-only) database ---
# mssql for the real directory, mock for development and the demo.
EXTERNAL_DB_MODE=mssql

# Required when EXTERNAL_DB_MODE=mssql. Use a read-only SQL login.
#
# Prefer TLS if the server offers it:
MSSQL_DSN=sqlserver://readonly_user:PASSWORD@sql.example.com:1433?database=STORE_IT_APL_PROD&encrypt=true&TrustServerCertificate=false
#
# The STORE_IT_APL_PROD server this was verified against did not offer TLS on
# its SQL Server endpoint at the time of testing, which needed encrypt=disable
# instead. Verify with your DBA whether TLS is available before falling back
# to that: it sends the read-only credentials and every row in the clear.
# MSSQL_DSN=sqlserver://readonly_user:PASSWORD@sql.example.com:1433?database=STORE_IT_APL_PROD&encrypt=disable

# How long the store-wide client list is cached in memory.
CLIENT_LIST_CACHE_TTL=5m

# --- Secrets ---
# 32 random bytes, base64. Encrypts the SMTP password and the TOTP secrets.
# Generate with:  openssl rand -base64 32
# Changing this makes every stored secret unreadable.
APP_ENCRYPTION_KEY=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64

# A separate secret (at least 16 random bytes, base64; generate the same way)
# shared with whoever generates entry links in the parent application. See
# README.md, "Entry link format", for the exact signing contract.
ENTRY_LINK_SECRET=REPLACE_ME_WITH_16+_RANDOM_BYTES_BASE64

# Mandatory signature + expiry check on the entry link
# (GET /r/{code}/{login}?exp=...&sig=...). Leave this unset (or true) in every
# real deployment; see README.md.
#
# Set to false ONLY for local development or automated testing against the
# mock directory, to use plain GET /r/{code}/{login} links with no signature:
# the app refuses to start with this false while EXTERNAL_DB_MODE=mssql.
ENTRY_LINK_SIGNING_ENABLED=false

# --- Sessions ---
SESSION_IDLE_TIMEOUT=2h
SESSION_ABSOLUTE_TIMEOUT=12h

# Set to false only for local development over plain HTTP.
COOKIE_SECURE=true

# Comma-separated CIDRs of the reverse proxy. X-Forwarded-For is trusted only
# from these; leave empty if the app is reached directly.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# --- First administrator ---
# Used only when no administrator exists yet. Remove both after the first
# login; the application logs a warning while they remain set.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_10_CHARS

# --- Admin 2FA ---
# Mandatory TOTP 2FA on every admin login. Leave this unset (or true) in every
# real deployment.
#
# Set to false ONLY for local development or automated testing against the
# mock directory: the app refuses to start with this false while
# EXTERNAL_DB_MODE=mssql, so it cannot be disabled against a real deployment
# by mistake. Startup also logs a loud warning whenever it is off.
ADMIN_2FA_ENABLED=false

# --- Logging ---
# debug, info, warn or error.
LOG_LEVEL=info
